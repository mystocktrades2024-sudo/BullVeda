{
  "_meta": {
    "version": 2,
    "name": "CapStudio Capability Registry",
    "description": "Single source of truth for all gateable functions. Edited by hand to add/remove functions; admin assigns roles via Settings \u2192 Roles UI which loads this file dynamically.",
    "schema_v2_notes": [
      "v2 (2026-05-09): added 'groups' for visual categorization in the Roles UI; merged the existing settings_roles.html taxonomy with elite-detail.html actual fdtab IDs (so gating works end-to-end).",
      "Each item belongs to a group (visual section in the UI) and has a perm_type (tabs|sub_tabs|actions) that determines how user_has_permission() in auth.py looks it up."
    ],
    "last_updated": "2026-05-09"
  },
  "groups": [
    {
      "id": "main_tabs",
      "label": "\ud83d\udcca Main Dashboard Tabs",
      "perm_type": "tabs",
      "description": "Top-level sidebar items in the V2 dashboard."
    },
    {
      "id": "ticker_drilldown",
      "label": "\ud83d\udd0d Per-Ticker Drill-Down",
      "perm_type": "sub_tabs",
      "description": "Sub-tabs visible when opening a single ticker (elite-detail.html)."
    },
    {
      "id": "settings_subtabs",
      "label": "\u2699\ufe0f Settings Sub-Tabs",
      "perm_type": "tabs",
      "description": "Sub-sections inside the Settings tab (Visibility / Config / Admin / Users / Roles)."
    },
    {
      "id": "ops_actions",
      "label": "\u26a1 Actions & Write Permissions",
      "perm_type": "actions",
      "description": "Discrete actions / write operations that need a role gate."
    }
  ],
