{
  "version": 1,
  "_note": "Built-in roles (admin/trader/viewer) cannot be deleted. Custom roles can be added/removed.",
  "roles": {
    "admin": {
      "name": "Admin",
      "description": "Full system-wide access. Can manage users, override gates, edit config.",
      "color": "fail",
      "builtin": true,
      "permissions": {
        "tabs": ["*"],
        "actions": ["*"]
      }
    },
    "trader": {
      "name": "Trader",
      "description": "Daily operator. Submits trades, edits watchlist, full dashboard read.",
      "color": "pass",
      "builtin": true,
      "permissions": {
        "tabs": [
          "elite", "scanner", "watchlist", "portfolio", "alerts", "killed",
          "performance", "screener", "industries", "market", "macro", "premarket",
          "events", "themes", "strategies", "crypto", "playbook", "accuracy",
          "ticker_overview", "ticker_chart", "ticker_fund", "ticker_intel", "ticker_plan",
          "ticker_gates", "ticker_forward_dist",
          "settings_profile", "settings_alerts"
        ],
        "actions": [
          "submit_trade", "edit_watchlist", "set_alerts", "move_stops",
          "edit_sizing", "export_data", "ai_chat"
        ]
      }
    },
    "viewer": {
      "name": "Viewer",
      "description": "Read-only audit / accountant access. Sees signals, no actions.",
      "color": "info",
      "builtin": true,
      "permissions": {
        "tabs": [
          "elite", "scanner", "watchlist", "portfolio", "killed", "performance",
          "screener", "industries", "market", "macro", "premarket", "events",
          "themes", "strategies", "playbook", "accuracy",
          "ticker_overview", "ticker_chart", "ticker_fund", "ticker_intel", "ticker_plan",
          "ticker_gates", "ticker_forward_dist",
          "settings_profile"
        ],
        "actions": ["export_data"]
      }
    }
  }
}
