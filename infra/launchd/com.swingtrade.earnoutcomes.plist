<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.swingtrade.earnoutcomes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/track_earnings_outcomes.py</string>
  </array>
  <!-- 2026-05-27: 13:30 → 13:55 so daily-scan + audit-ledger-eod complete first.
       Previous 13:30 collision was producing exit=1 because bundle was locked. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>55</integer></dict>
  <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/earnings_outcomes.log</string>
  <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/earnings_outcomes.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
