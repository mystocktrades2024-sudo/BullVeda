<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.enrich-nightly</string>

  <key>ProgramArguments</key>
  <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.enrich-nightly</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/enrich_nightly.py</string>
    <string>--universe</string>
    <string>all</string>
    <string>--skip-fundamentals</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <!-- Fires nightly at 02:15 PT — TECH-ONLY warm (2026-06-03).
       --skip-fundamentals: fundamentals are quarterly data; re-pulling ~3000
       per-ticker EVERY night (old 24h TTL) burned ~18K calls/week for nothing.
       Fundamentals now refresh WEEKLY on Saturday via
       com.swingtrade.enrich-fundamentals-weekly. This nightly run pre-warms only:
         - bulk_eod          (1 call)
         - calendar/trends   (~30 bulk calls)
         - calendar/earnings (~30 bulk calls)
         - insider summary   (top 200)
       Runtime ~1-2 min. Cost ~60-260 calls/night vs ~3000 before. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/swingtrade-enrich-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swingtrade-enrich-nightly.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
