<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.enrich-nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/enrich_nightly.py</string>
    <string>--universe</string>
    <string>all</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <!-- Fires once nightly at 02:15 PT. Pre-warms:
         - bulk_eod  (1 call)
         - calendar/trends   (~30 bulk calls)
         - calendar/earnings (~30 bulk calls)
         - fundamentals      (~3000 per-ticker, 24h TTL)
         - insider summary   (top 200)
       Expected runtime ~6 minutes. Daily quota usage stays well under 100k. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/swingtrade-enrich-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swingtrade-enrich-nightly.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
