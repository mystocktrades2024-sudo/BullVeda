<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.enrich-fundamentals-weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
    <string>com.swingtrade.enrich-fundamentals-weekly</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/enrich_nightly.py</string>
    <string>--universe</string>
    <string>all</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <!-- WEEKLY full fundamentals refresh — Saturday 03:00 PT (2026-06-03).
       Markets are closed, the full EODHD quota is free, and no intraday scans
       compete. This is the ONE cold fundamentals fetch per week (~3000 per-ticker
       calls). _warm_fundamentals() reads with a 6-day TTL, so Saturday (7 days
       since the last Saturday warm) reliably re-fetches; the resulting 7-day
       cache stays warm for every weekday scan (which read at the 7-day default
       TTL). Weeknight enrich-nightly runs --skip-fundamentals so it never
       re-pays this bill. Net: ~3000 fundamentals calls/WEEK instead of /night
       (~18K/week reclaimed). Runtime ~6-10 min paced. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>6</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/swingtrade-enrich-fundamentals-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swingtrade-enrich-fundamentals-weekly.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
