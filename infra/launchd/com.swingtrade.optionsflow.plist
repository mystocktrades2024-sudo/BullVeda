<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Options-flow refresher — runs refresh_options_flow.py every 5 minutes,
  24/7. The script self-gates to Mon-Fri 5:30am-1:30pm PT (extended for
  pre-market + post-close settled-print window) and bails silently
  outside that window.

  Mirror of the active plist at ~/Library/LaunchAgents/.
  Activate (idempotent):
    cp infra/launchd/com.swingtrade.optionsflow.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.swingtrade.optionsflow.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.swingtrade.optionsflow.plist
-->
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.optionsflow</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_options_flow.sh</string>
  </array>

  <!-- Every 15 minutes, 24/7. The script self-checks market hours -->
  <!-- (Mon-Fri 5:30am-1:30pm PT, extended for pre-market + post-close -->
  <!-- settled prints) and bails silently outside that window. -->
  <!-- 2026-05-19: dropped from 1800s → 300s for live-tier freshness. -->
  <!-- 2026-05-30: raised 300s → 900s to relieve EODHD quota contention. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/options_flow_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/options_flow_launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
