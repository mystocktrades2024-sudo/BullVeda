<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.nas-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.nas-sync</string>
        <string>/bin/bash</string>
        <string>scripts/nas_sync_all.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- Nightly catch-up at 20:30 PT — backfills any rows missed if the NAS was
         briefly unreachable during a scan's real-time push. Incremental + idempotent. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>20</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/nas-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/nas-sync.err</string>
</dict>
</plist>
