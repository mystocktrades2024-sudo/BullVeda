<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.ml-edge</string>

    <!-- Run daily at 5:00 AM PT (Mon-Fri).
         Fires BEFORE the 6:30 AM morning briefing so the AI Prediction
         workspace tab has fresh universe-wide predictions ready when the
         user opens the dashboard before market open.

         Runtime: ~5-8 min over the union universe (~3000 tickers × 3 modes)
         when EODHD cache is warm; up to ~30 min cold. Cron-safe — log goes
         to /tmp/ml-edge.log so failures are visible. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>5</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>1</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>5</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>2</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>5</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>5</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>4</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>5</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>5</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.ml-edge</string>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>ml.run_ml_edge</string>
        <string>--universe</string>
        <string>bundle</string>
        <string>--min-adv</string>
        <string>5000000</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/ml-edge.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ml-edge.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- RunAtLoad=false: don't fire on plist install, only on schedule.
         To install:
           launchctl load infra/launchd/com.swingtrade.ml-edge.plist
         To verify scheduled:
           launchctl list | grep ml-edge
         To run manually for testing:
           python3 -m ml.run_ml_edge --universe all --min-adv 5000000 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
