<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.audit-ledger-eod</string>

    <!-- 2026-05-18 · End-of-day rebuild of audit_ledger so today's close fills
         in D1 for yesterday's picks. The morning-briefing 6:30 AM PT run
         CAN'T do this — it fires BEFORE market opens, so the previous day's
         pick has no D1 close to attribute. Running again at 1:30 PM PT
         (30 min after market close) closes that gap.

         Combined cadence:
         - 1:30 PM PT (this plist)  →  fills today's D1 for yesterday's picks
         - 6:30 AM PT (run_daily_scan.sh)  →  refreshes D2+ from previous day's close
         - Result: by tomorrow morning, ALL D1+ horizons for picks ≥1 trading day
           old are populated. -->

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.audit-ledger-eod</string>
        <string>/usr/bin/python3</string>
        <string>infra/prototype/build_audit_ledger.py</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/audit-ledger-eod.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/audit-ledger-eod.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
