<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.desk-entry-watch</string>

    <!-- Every 5 min. Script self-gates to market hours (_is_market_hours), so
         weekend/overnight runs exit immediately. Real-time per-desk entry-zone
         alerts for Screener-Desk picks on live Schwab quotes (zero EODHD). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.desk-entry-watch</string>
        <string>/usr/bin/python3</string>
        <string>scripts/desk_entry_watch.py</string>
        <string>--send</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/desk-entry-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/desk-entry-watch.err</string>
</dict>
</plist>
