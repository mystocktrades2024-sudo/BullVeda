<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.eodhd-quota-snapshot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/snapshot_eodhd_quota.py</string>
  </array>

  <!-- Daily at 16:50 PT — just before EODHD's 00:00 UTC counter reset (5pm PDT). -->
  <!-- Captures the day's near-peak BILLED usage (1 EODHD call) → appends one line   -->
  <!-- per UTC day to data/eodhd_quota_history.jsonl. This is the only reliable      -->
  <!-- per-day billed-quota history (the Supabase scan-call table undercounts ~20-60x -->
  <!-- because bulk_eod bills ~2900 units per HTTP call). View: --show.              -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>16</integer>
    <key>Minute</key><integer>50</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/eodhd_quota_snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/eodhd_quota_snapshot.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
