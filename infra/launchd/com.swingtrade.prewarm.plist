<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.prewarm</string>

  <key>ProgramArguments</key>
  <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.prewarm</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/prewarm_cache.py</string>
    <string>--tickers</string>
    <string>200</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <!-- Reduced from 14 fires (every 30 min 06:30-13:00 PT) to THREE daily
       fires (06:45, 09:30, 12:30 PT) to relieve EODHD 100K/day quota
       contention (2026-05-30). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <!-- One run per day (any time) that also refreshes fundamentals (1d TTL).
       This second job is loaded separately if you want it. -->

  <key>StandardOutPath</key>
  <string>/tmp/swingtrade-prewarm.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swingtrade-prewarm.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
