<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.desk-resolve</string>

    <!-- Morning desk GRADING run (Mon-Fri 6:35 AM PT), right after the ~4 AM
         OHLCV parquet refresh lands the prior session's completed daily bar.
         Runs `desk_signal_log.py --resolve` (grade matured + aggregate, NO new
         logging) then rebuilds the Track-Record ledger — so desk calls grade
         their next forward-return column first thing each morning instead of
         waiting for the 14:20 run. Zero EODHD (reads cached parquets only). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_desk_signal_log.sh</string>
        <string>--resolve</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/desk-resolve.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/desk-resolve.err</string>
</dict>
</plist>
