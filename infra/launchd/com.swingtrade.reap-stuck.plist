<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.reap-stuck</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.reap-stuck</string>
        <string>/usr/bin/python3</string>
        <string>scripts/reap_stuck_jobs.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- Every 30 min — kill any heavy job hung past its max runtime (anti-pileup). -->
    <key>StartInterval</key><integer>1800</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/tmp/reap-stuck.log</string>
    <key>StandardErrorPath</key><string>/tmp/reap-stuck.err</string>
</dict>
</plist>
