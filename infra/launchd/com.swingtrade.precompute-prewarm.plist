<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.precompute-prewarm</string>

    <!-- Run daily at 3:00 AM PT (Mon-Fri only), BEFORE the 6:30 AM scan.
         Post-midnight so the EODHD daily quota has reset to a fresh budget.

         Daily-Clock rebuild (2026-06): this 3 AM pass is now the LIGHT MORNING
         phase — `precompute_top1000.py --phase morning`. The HEAVY bar-dependent
         lift (structural targets ×3 modes + SMC, ≈8.3k EODHD + ≈2.8k Schwab-4H)
         moved to the 7:30 PM PT com.swingtrade.eod-targets job, which computes
         them ONCE at EOD when the daily bar + 4H are freshest. So at 3 AM we only:
           · refresh Finviz/EODHD fundamentals (fast, no 4H), and
           · gap-fill structural caches the EOD job missed or that are now stale
             (names that failed at EOD, or new since) — usually a handful.
         Target ~5 min instead of ~28 min, OFF the pre-market critical path.

         Universe ranking is unchanged: ranks SP500∪R1000∪R2000∪NASDAQ-liquid by
         dollar-volume (one bulk_eod call), top 1000 ∪ every track-record
         (audit_ledger) + portfolio ticker. Options skipped (Schwab in-session
         only); ML is a separate pipeline.

         Throttling is enforced at the client level — NOT here:
           · EODHD: 950 req/min token bucket (cross-process shared) + daily
             quota guard (throttle@85% / abort@97%) in eodhd_client.py
           · Schwab (4H): paced to 100/min w/ 429 backoff in schwab_client.py
         precompute runs without --force-refresh, so 12h-fresh caches are
         skipped (cache hits, zero API). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>3</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>1</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>3</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>2</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>3</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>3</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>4</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>3</integer>
            <key>Minute</key><integer>0</integer>
            <key>Weekday</key><integer>5</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.precompute-prewarm</string>
        <string>/usr/bin/python3</string>
        <string>scripts/precompute_top1000.py</string>
        <string>--phase</string>
        <string>morning</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/precompute-prewarm.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/precompute-prewarm.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- RunAtLoad=false: don't fire on plist install, only on schedule -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
