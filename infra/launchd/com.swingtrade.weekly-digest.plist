<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.weekly-digest</string>

    <!-- 2026-05-27: fires Sun 06:00 PT after the weekend heavy jobs (insider-
         cluster-weekly Sun 04:00, congressional-weekly Sun 04:30,
         walk-forward Mon-Fri 22:00). 7-day window of activity. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.weekly-digest</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/weekly_digest.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/weekly_digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/weekly_digest.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key><false/>
</dict>
</plist>
