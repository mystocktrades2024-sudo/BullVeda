<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.swingtrade.beatpredict</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/predict_earnings_beats.py</string>
  </array>
  <!-- 2026-06-10 · Retimed 05:40 → 04:30 PT (Catalysts pipeline). Still runs
       after earnings_watchlist + corporate-events (both 04:30, this fires in
       the same slot but reads their fresh JSON on next-bar; ordering preserved
       because beatpredict reads cache, doesn't block on them). -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/predict_earnings_beats.log</string>
  <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/predict_earnings_beats.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
