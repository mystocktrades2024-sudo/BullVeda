<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.congressional-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.congressional-weekly</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/build_universe_congressional.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- Sunday 4:30am PT — after the insider scan, before Monday morning scan.
         Disclosures are filed under STOCK Act with up to 45-day delay; weekly
         cadence is more than enough granularity. Cheap (~2 HTTPS calls).
         Currently the free S3 sources are access-restricted; the script ships
         the infrastructure ready for a working public feed. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/congressional.log</string>
    <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/congressional.err</string>
</dict>
</plist>
