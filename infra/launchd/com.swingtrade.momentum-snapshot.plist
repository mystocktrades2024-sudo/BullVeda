<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/plist-1.0.dtd">
<!--
  com.swingtrade.momentum-snapshot — daily momentum leaders snapshot.
  Captures the day's RS-rank leaders + momentum metrics to
  data/momentum_snapshots.jsonl for the Momentum tab HISTORY sub-view.
  08:15am PT daily (after morning scan + briefing). weekly_diagnostics.sh also
  runs it Sundays as backup. Safe to run multiple times/day (skips if dated).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.momentum-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
    <string>com.swingtrade.momentum-snapshot</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/momentum_snapshot.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
  <key>StandardOutPath</key>
  <string>/tmp/swingtrade-momentum-snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swingtrade-momentum-snapshot.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
