<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.schwabtoken</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/check_schwab_token.py</string>
  </array>

  <!-- Daily at 6:00am PT (before market opens at 6:30am PT). -->
  <!-- Forces a refresh every day, which rotates the refresh_token and -->
  <!-- extends its 7-day life. If refresh fails, posts a Slack alert. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/schwab_token_check.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/schwab_token_check.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
