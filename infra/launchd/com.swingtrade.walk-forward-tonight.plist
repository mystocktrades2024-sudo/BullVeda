<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.walk-forward-tonight</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/run_walk_forward_overnight.sh</string>
  </array>

  <!-- 2026-05-27: 23:00 → 22:00 PT so the 6h hard cap finishes by 04:00 PT,
       before pre-market jobs at 05:30 PT.
       2026-06-13: Mon-Fri (5 nights/wk) → FRIDAY-ONLY weekly. Walk-forward
       validation only needs re-running weekly (CLAUDE.md principle 11: Wilson
       CI re-computed monthly — weekly is generous). Nightly was 5-9h of
       4-worker CPU every night for marginal benefit, and once ran away to 37h
       (load avg 70, tunnel down). Fri 22:00 → Sat AM, market closed, captures
       the full trading week. Reversible: restore the 5 weekday dicts. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/walkforward_launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/walkforward_launchd.stderr.log</string>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
