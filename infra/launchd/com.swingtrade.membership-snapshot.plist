<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.membership-snapshot</string>

    <!-- #2 · Monthly point-in-time membership snapshot for S&P 500, R1000, R2000.
         Runs on the 1st of each month at 6 AM PT. Idempotent — won't overwrite
         existing files. Over time, accumulates enough history to support
         honest point-in-time backtests (survivorship-bias-aware). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key><integer>1</integer>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.membership-snapshot</string>
        <string>/usr/bin/python3</string>
        <string>scripts/snapshot_membership.py</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/membership-snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/membership-snapshot.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
