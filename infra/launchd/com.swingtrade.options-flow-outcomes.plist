<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.options-flow-outcomes</string>

  <!-- Resolves options-flow snapshot outcomes nightly at 9:00 PM PT (after
       market close + EOD bars are settled). Each pick logged earlier in
       cache/options_flow_history.jsonl gets walked through its forward
       price action to determine target_hit / stop_hit / expired. Results
       written to cache/options_flow_outcomes.jsonl for the Options-tab
       Accuracy block. -->

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/options_flow_outcomes.py</string>
    <string>--horizon</string>
    <string>21</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/options_flow_outcomes.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/options_flow_outcomes.err.log</string>

  <!-- Daily at 21:00 PT -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
