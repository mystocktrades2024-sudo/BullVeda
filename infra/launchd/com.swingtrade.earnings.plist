<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.earnings</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/build_earnings_watchlist.py</string>
  </array>

  <!-- 2026-06-10 · Retimed 05:30 → 04:30 PT to match the data_loading_diagram
       "Catalysts" pipeline (04:30) — runs before the 05:00 scan so the         -->
  <!-- pre-earnings watchlist guarantees inclusion of tickers reporting        -->
  <!-- in the next 10 days.                                                     -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/earnings_watchlist.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/earnings_watchlist.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
