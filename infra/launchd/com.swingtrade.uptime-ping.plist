<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OPS-2 (2026-05-10): SwingTrade FastAPI uptime monitor.

  Pings http://localhost:7432/api/health-ping every 5 minutes.
  On 2 consecutive failures, posts to Slack via SLACK_WEBHOOK_URL from .env.
  On recovery, posts a recovery message.
  All checks logged to /tmp/swingtrade-uptime.log (and ~/.swingtrade/uptime.jsonl).

  Install:
    cp infra/launchd/com.swingtrade.uptime-ping.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.swingtrade.uptime-ping.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.swingtrade.uptime-ping.plist
    rm ~/Library/LaunchAgents/com.swingtrade.uptime-ping.plist

  Verify running:
    launchctl list | grep swingtrade.uptime
    tail -f /tmp/swingtrade-uptime.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.uptime-ping</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/infra/launchd/uptime_ping.sh</string>
    </array>

    <!-- Every 300 seconds (5 minutes) -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/tmp/swingtrade-uptime.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/swingtrade-uptime.log</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Don't run if user is not logged in (avoids running at boot before login) -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
</dict>
</plist>
