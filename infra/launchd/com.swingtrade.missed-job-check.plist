<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.missed-job-check</string>

    <!-- 2026-06-09 · Phase 5 (Resilience) · Open Risk #11 — missed-job watchdog.
         Runs 07:30 PT Mon-Fri, AFTER the morning chain should be done
         (precompute-prewarm 03:00, strategy-warm 06:15, morning-briefing 06:30,
         scan ~06:30). Verifies each critical scheduled job actually ran in its
         most-recent window (proof from launchd_wrapper.log END lines + artifact
         mtimes). If the Mac idle-slept overnight and missed the 19:30 EOD-targets
         or the morning passes, posts ONE Slack WARN naming the missed job(s).
         Companion to the Phase 5 `caffeinate -i` load-window wrap (the preventer;
         this is the detector). Exits 0 always. -->

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.missed-job-check</string>
        <string>/usr/bin/python3</string>
        <string>scripts/check_missed_jobs.py</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/missed_job_check.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/missed_job_check.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
