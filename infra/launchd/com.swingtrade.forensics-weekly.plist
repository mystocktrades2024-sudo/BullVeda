<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/plist-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.forensics-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
    <string>com.swingtrade.forensics-weekly</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/pick_forensics.py</string>
    <string>--slack</string>
    <string>--days</string>
    <string>14</string>
  </array>
  <!-- Sunday 17:30 PT — after weekly-diagnostics (17:00) + the week's trades have closed
       & been labeled. Posts the 14d pick-forensics digest (BUY/WATCH verdict truth +
       per-sleeve EXTENDED/MISSED bleeding monitor) to Slack. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>17</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/forensics_weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/forensics_weekly.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
