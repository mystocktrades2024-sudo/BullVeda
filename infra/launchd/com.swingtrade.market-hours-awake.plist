<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.market-hours-awake</string>
  <!-- Hold the Mac awake through the morning + market-hours alert window so the -->
  <!-- briefing (6:30), signal alerts (7:15), and entry-watcher (every 5min) can -->
  <!-- post to Slack. 25200s = 7h: 6:20 AM PT -> ~1:20 PM PT (covers 9:30-16:00 ET -->
  <!-- market close). caffeinate -s prevents system sleep on AC power.            -->
  <!-- NOTE: this only holds the Mac awake ONCE it is awake at 6:20. To WAKE it   -->
  <!-- from sleep, a `sudo pmset repeat wake` schedule is also required (one-time).-->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>-t</string>
    <string>25200</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/market_hours_awake.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/market_hours_awake.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
