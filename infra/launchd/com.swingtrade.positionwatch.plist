<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.positionwatch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_position_watch.sh</string>
  </array>

  <!-- Every 60 seconds, 24/7. position_alerts.run_alerts_pass()             -->
  <!-- bails fast outside market hours (9:30-4pm America/New_York, Mon-Fri). -->
  <!-- During market hours: ~6.5h × 60min × ~5 positions = ~1950 quote calls -->
  <!-- per day, well under Schwab/EODHD limits.                              -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/position_watch_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/position_watch_launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
