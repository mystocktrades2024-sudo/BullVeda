<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.positionwatch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_position_watch.sh</string>
  </array>

  <!-- Every 5 min, 24/7 (2026-06-14, was 60s). position_alerts.run_alerts_pass()  -->
  <!-- bails fast outside market hours (9:30-4pm America/New_York, Mon-Fri).        -->
  <!-- Stops are CLOSE-BASED on 2-5 day swing horizons → minute-resolution intraday -->
  <!-- monitoring is unnecessary; 5 min cuts market-hours quote calls ~5x (1950→390)-->
  <!-- + off-hours bail churn (1440→288 fires/day). Reversible: set back to 60.     -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/position_watch_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/position_watch_launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
