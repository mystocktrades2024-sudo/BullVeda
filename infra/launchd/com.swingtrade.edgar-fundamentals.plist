<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.edgar-fundamentals</string>

  <key>ProgramArguments</key>
  <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.edgar-fundamentals</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/edgar_fundamentals_nightly.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <!-- Fires once nightly at 02:00 PT, BEFORE enrich-nightly (02:15). Populates the
       point-in-time financial-statement columns of fundamentals.db (revenue_ttm /
       revenue_growth / eps_ttm / eps_growth_qoq) from free SEC EDGAR companyfacts.
       Column-scoped UPSERT — never touches the EODHD market columns. SEC-throttled
       (<10 req/s), 3-day disk cache. ~24 min for ~2,500 tickers. Zero EODHD quota. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/swingtrade-edgar-fundamentals.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/swingtrade-edgar-fundamentals.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
