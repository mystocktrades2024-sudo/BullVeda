<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.siglog-verify</string>

    <!-- Monday 7:30 AM PT — runs AFTER the 6:30 AM morning scan so signal_log +
         last_bundle reflect the fresh post-ranker run. Confirms SIGLOG-ORDER-FIX
         (commit dbe025e08) held: signal_log BUYs == canonical engine BUYs, no
         sub-60 leakage. Recurring weekly = ongoing data-integrity guard against
         regression. Posts result to Slack (PASS=INFO, MISMATCH=WARN). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>7</integer>
            <key>Minute</key><integer>30</integer>
            <key>Weekday</key><integer>1</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.siglog-verify</string>
        <string>/usr/bin/python3</string>
        <string>scripts/verify_signal_log_fix.py</string>
        <string>--slack</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/siglog-verify.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/siglog-verify.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
