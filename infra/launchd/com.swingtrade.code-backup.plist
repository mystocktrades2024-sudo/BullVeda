<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.code-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.code-backup</string>
        <string>/bin/bash</string>
        <string>scripts/backup_code_to_nas.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- Nightly 21:00 PT. Runs as a LaunchAgent in the user GUI session, so the
         SMB CodeBackup mount is visible. No-op with a clear message if unmounted. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/code-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/code-backup.err</string>
</dict>
</plist>
