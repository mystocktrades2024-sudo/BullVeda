<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.always-awake</string>
    <!-- 24/7 wake lock for always-on serving: prevent idle + system sleep so the
         FastAPI server + Cloudflare tunnel stay reachable at all hours. KeepAlive
         restarts caffeinate if it's ever killed; RunAtLoad starts it immediately.
         Supersedes the weekday-only market-hours-awake for serving purposes.
         (Prevents sleep while on AC power — keep the Mac plugged in.) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/always-awake.err</string>
</dict>
</plist>
