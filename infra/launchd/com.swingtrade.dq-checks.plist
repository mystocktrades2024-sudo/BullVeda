<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.dq-checks</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.dq-checks</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/dq_checks.py</string>
        <string>--apply</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- 2026-05-27: 06:00 → 05:50 so DQ verdict is available BEFORE daily-scan
         starts at 06:00 PT. Gates the scan with a data-quality check. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
    <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/dq-checks.log</string>
    <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/dq-checks.err</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
