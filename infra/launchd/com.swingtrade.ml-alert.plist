<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/plist-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.ml-alert</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
    <string>com.swingtrade.ml-alert</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/ml_alert_slack.py</string>
    <string>--mode</string>
    <string>swing-stale</string>
  </array>
  <!-- Mon-Fri 06:50 PT — after the 06:00 scan + ML-edge run_after_scan, posts the top
       ML-edge / AI-prediction BUY picks (by p_up) to Slack. Fills the Q1 gap: no ML/AI
       Slack alert existed before. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>50</integer></dict>
  </array>
  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/ml_alert.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/ml_alert.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
