<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.ml-close-loop</string>

    <!-- Daily at 7:00 PM PT (after market close + EOD bars settle).
         Resolves pending picks → writes realized_pct so Sunday's retrain
         has fresh outcome labels. Posts Slack alert if any picks resolved. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>19</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.ml-close-loop</string>
        <string>/bin/bash</string>
        <string>scripts/ml_close_loop_runner.sh</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/ml-close-loop.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ml-close-loop.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
