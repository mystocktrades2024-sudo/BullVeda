<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.swingtrade.earnposcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/earnings_position_check.py</string>
  </array>
  <!-- 5:35am PT — 5 min after build_earnings_watchlist.py refresh. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>35</integer></dict>
  <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/earnings_position_check.log</string>
  <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/earnings_position_check.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
