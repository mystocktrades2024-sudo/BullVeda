<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.zacks-buylist</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.zacks-buylist</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/zacks_buylist_export.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- 2026-07-16 · Daily Zacks Rank #1 buy-list → Excel export.
         Scrapes https://www.zacks.com/stocks/buy-list/ (Zacks Premium), parses
         ticker + VGM grades, cross-refs our engine verdict, writes
         cache/zacks_buylist_{YYYYMMDD,latest}.xlsx + latest.json.

         ISOLATED from the main scan on purpose: the owner disabled Zacks in the
         scan (config.skip_zacks) because the Selenium login is the system's most
         fragile dependency. This job runs its own driver with DYNAMIC Chrome-
         version detection (no hard-pinned version_main), so a Chrome auto-update
         degrades only this Excel export — never the scan. Failure exits non-zero
         and touches nothing else.

         05:00 AM PT — Zacks refreshes ranks pre-market; writes the workbook +
         picks.json into MasterAlgo/cache/Zacks/ (served at /MASTERALGO/Zacks/)
         for the "My Picks" tab, ahead of the 06:30 morning briefing. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>5</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/zacks_buylist.log</string>
    <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/zacks_buylist.err</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
