<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.insider-cluster-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.insider-cluster-weekly</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/build_universe_insider_cluster.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- Sunday 4:00am PT — well before Monday's first scan at 06:00.
         Insider cluster cadence is weekly because insider filings settle in
         T+2 to T+5 days; daily re-scan would mostly return identical results.
         Heavy: ~3000 EODHD insider_transactions calls (~10-15 min). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/insider-cluster.log</string>
    <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/insider-cluster.err</string>
</dict>
</plist>
