<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.archive-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
    <string>com.swingtrade.archive-sync</string>
    <string>/usr/bin/python3</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/archive_sync.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

  <!-- Nightly 04:00 PT: refresh the OHLCV Parquet archive (1 bulk_eod call) +
       backfill any scored/held ticker missing a parquet, so ML Edge feature
       extraction reads local Parquet (fast) instead of live 400d fetches. Runs
       before the 05:15 scan + 06:45 ML. Cheap: 1 bulk call + N new-ticker downloads. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/archive_sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/archive_sync.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
