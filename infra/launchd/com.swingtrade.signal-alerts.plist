<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.signal-alerts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_signal_alerts.sh</string>
  </array>
  <!-- 7:15 PT daily — after the 7:00 PT scan refreshes last_bundle.json.       -->
  <!-- Day-over-day diff: WATCH->BUY flips + new Elite Picks. Fires nothing on  -->
  <!-- the first (seed) run. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/signal_alerts_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/signal_alerts_launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
