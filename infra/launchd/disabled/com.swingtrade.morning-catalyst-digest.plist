<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.morning-catalyst-digest</string>

    <!-- 2026-05-27: fires 05:55 PT, AFTER dq-checks (05:50) + thematic (05:45)
         + corporate-events (05:30) + earnings (05:30) + beatpredict (05:40),
         and BEFORE the 06:00 PT daily scan. Mon-Fri only — no Slack noise on weekends. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.morning-catalyst-digest</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/morning_catalyst_digest.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/morning_catalyst_digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/morning_catalyst_digest.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key><false/>
</dict>
</plist>
