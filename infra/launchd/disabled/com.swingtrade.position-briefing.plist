<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.position-briefing</string>

    <!-- Daily 8am PT (after morning newsletter at 7:45am) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/morning_position_briefing.sh</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/morning-position-briefing.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/morning-position-briefing.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
