<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.thematic-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.thematic-daily</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/build_universe_thematic.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <!-- 2026-06-10 · Retimed 05:45 → 01:30 PT to match the data_loading_diagram
         "Universe-Layers" pipeline (01:30). Runs well ahead of the 04:30
         catalysts pass and 05:00 scan so the thematic universe is warm in cache.
         Cheap: ~25 EODHD calls (22 ETF + 1 screener + 2 retry overhead). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>1</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/thematic.log</string>
    <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/thematic.err</string>
    <!-- Also a redundant trigger inline in run_daily_scan.sh so this plist
         is optional. Load it if you want the thematic universe refreshed
         independently of the main scan. -->
</dict>
</plist>
