<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.swingtrade.screener-desks-live</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_screener_desks_live.sh</string>
  </array>

  <!-- Every 2 min. Script self-gates to market hours (9:30-16:00 ET, Mon-Fri);
       off-hours fires are ~free no-ops. One Schwab batch quote covers all desk
       tickers => ZERO EODHD quota cost, same pattern as entrywatch/positionwatch. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/screener_desks_live_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/screener_desks_live_launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
