<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.swingtrade.corporate-events</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.corporate-events</string>
        <string>/usr/bin/python3</string>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/fetch_corporate_events.py</string>
        <string>30</string>
    </array>
    <key>WorkingDirectory</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/corporate-events.log</string>
    <key>StandardErrorPath</key><string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/corporate-events.err</string>
    <key>RunAtLoad</key><true/>
</dict>
</plist>
