<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.swingtrade.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_daily_scan.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stdout.log</string>
	<!-- 1 HEAVY pre-market + 4 LIGHT/day (2026-06-13, QUOTA-WEEKDAY-CADENCE).
	     RESTORED to the documented spec: docs/bullveda_refresh_spec.md line 156
	     "Scans = 1 heavy + 4 light/day" + run_daily_scan.sh header. The prior
	     16-slot (light every 30 min) array was undocumented drift that tripled the
	     spec; its "~250 net/light scan, ~8K/day" cost model was wrong (cold-cache
	     light scans hit ~1,042 net + intraday billed-units, contributing to the
	     06-08/06-12/06-13 96-100% quota days). SCAN_MODE by clock: <06:15 = heavy
	     (full deep-enrich + options/UOA/gamma + ML retrain + morning builders),
	     else = light (re-rank ALL from warm cache, deep-enrich top ~150). Live
	     prices still tick 10-20s via Schwab between scans; scores/setups/RVOL now
	     refresh ~every 2h intraday (ample for 2-5 day swing horizons).
	       05:15 heavy · 07:00 / 09:30 / 11:30 / 13:30 light (open → 30m post-close) -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
	</array>
</dict>
</plist>
