<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.swingtrade.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_daily_scan.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stdout.log</string>
	<!-- 5x/day · 1 HEAVY pre-market + 4 LIGHT intraday (2026-06-03).
	     run_daily_scan.sh sets SCAN_MODE by clock: <06:15 = heavy (full
	     deep-enrich + options/UOA/gamma + ML retrain + morning builders),
	     else = light (re-rank ALL tickers from warm cache, deep-enrich top ~150).
	       05:15 PT  heavy   — pre-market / night full enrich (ready before 06:30 open)
	       07:00 PT  light   — after market open
	       09:30 PT  light   — mid-session #1
	       11:30 PT  light   — mid-session #2
	       13:30 PT  light   — after close (13:00 PT close + settle) -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>15</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>7</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>11</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
</dict>
</plist>
