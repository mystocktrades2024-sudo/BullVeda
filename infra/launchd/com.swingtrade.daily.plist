<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.swingtrade.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_daily_scan.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stdout.log</string>

	<!--
	  2026-05-27 · 6 fires/day · WORKFLOW-aligned, not clock-aligned
	  ───────────────────────────────────────────────────────────────
	  06:00 PT · pre-market briefing  (cold cache · ~3-4k EODHD calls)
	  06:30 PT · NYSE open bell       (9:30 ET · opening tick · gap-and-go capture)
	  07:00 PT · post-open + 30 min   (opening volatility settled · first-vol read)
	  11:00 PT · mid-day single check (cache hot · captures intraday evolution)
	  13:30 PT · post-close + 30 min  (daily bar locked · first AMC earnings wave)
	  15:00 PT · 2h post-EOD          (second AMC wave + reconciliation)
	  ───────────────────────────────────────────────────────────────
	  Total ~9-10k EODHD calls/day · ~10% of 100K quota
	  Foundation data (fundamentals 24h+30d TTL) doesn't re-fetch per run
	-->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>6</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>11</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
</dict>
</plist>
