<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.swingtrade.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/run_daily_scan.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/launchd_stdout.log</string>
	<!-- 1 HEAVY pre-market + LIGHT every 30 min through the session (2026-06-03).
	     run_daily_scan.sh sets SCAN_MODE by clock: <06:15 = heavy (full deep-enrich
	     + options/UOA/gamma + ML retrain + morning builders), else = light (re-rank
	     ALL tickers from warm cache, deep-enrich top ~150). Live prices tick 10-20s
	     (Schwab) between scans; these 30-min light re-ranks refresh scores/setups/
	     RVOL/entry-quality. Each light scan ~250 EODHD net (cache-warm) → ~8K/day
	     total, ~8% of the 95K cap. See docs/bullveda_refresh_spec.md.
	       05:15 heavy  ·  06:30-13:30 light every 30 min (open → 30m post-close) -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
	</array>
</dict>
</plist>
