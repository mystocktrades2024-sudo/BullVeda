<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/plist-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swingtrade.ml-accuracy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
    <string>com.swingtrade.ml-accuracy</string>
    <string>/bin/bash</string>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/ml_accuracy_cron.sh</string>
  </array>
  <!-- Daily at 19:30 PT — AFTER ml-close-loop (19:00) labels the day's realized
       outcomes, so the [3] REALIZED accuracy trend stays current. Appends a compact
       line to cache/ml/accuracy_history.jsonl + full report to cache/logs/ml_accuracy.log. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>19</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>
  <key>StandardOutPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/ml_accuracy_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/cache/logs/ml_accuracy_launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
