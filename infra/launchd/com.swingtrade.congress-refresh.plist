<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrade.congress-refresh</string>

    <!-- Run daily at 7:00 AM PT. Congressional trades carry up to a 45-day
         STOCK Act disclosure lag, so once-daily (before the morning briefing
         consumes the cache) is ample. Runs every day incl. weekends since
         filings post on weekends too. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/MyMacDisk/Claude Skills/SwingTrade/scripts/launchd_wrapper.sh</string>
        <string>com.swingtrade.congress-refresh</string>
        <string>/usr/bin/python3</string>
        <string>scripts/refresh_congress.py</string>
        <string>90</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/congress-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/congress-refresh.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
