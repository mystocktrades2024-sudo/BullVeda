<script>
// ─── Live clock ────────────────────────────────────────────────────
function tick() {
  const d = new Date();
  const t = [d.getHours(), d.getMinutes(), d.getSeconds()].map(n => String(n).padStart(2,'0')).join(':');
  const a = t + ' ET';
  const c1 = document.getElementById('clk');  if (c1) c1.textContent = a;
  const c2 = document.getElementById('clk2'); if (c2) c2.textContent = a;
}
setInterval(tick, 1000); tick();

// ─── Tab toggle ────────────────────────────────────────────────────
document.querySelectorAll('.tab').forEach(t => {
  t.onclick = () => {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('on'));
    document.querySelectorAll('.panel').forEach(x => x.classList.remove('on'));
    t.classList.add('on');
    document.getElementById('pan-' + t.dataset.pan).classList.add('on');
  };
});

// ─── Real-data wiring ─────────────────────────────────────────────
// Pulls data.json + tickers.json from the same directory and replaces
// all hardcoded mock values with the live scan output. Idempotent — if
// either fetch fails, the mock data stays intact.

const _fmt = (v, d=2) => v == null ? '—' : (typeof v === 'number' ? v.toFixed(d) : String(v));
const _pct = (v, d=2) => v == null ? '—' : (v > 0 ? '+' : '') + Number(v).toFixed(d);
const _money = (v) => v == null ? '—' : '$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const _ago = (iso) => {
  if (!iso) return '—';
  try {
    const t = new Date(iso); const now = new Date();
    const m = Math.floor((now - t) / 60000);
    if (m < 1) return 'now';
    if (m < 60) return `${m}m ago`;
    if (m < 1440) return `${Math.floor(m/60)}h ago`;
    return `${Math.floor(m/1440)}d ago`;
  } catch { return '—'; }
};
const _bapClass = (s) => s == null ? 'bad' : s >= 75 ? '' : s >= 65 ? 'lo' : 'bad';

(async function wire() {
  let data = null, tickers = null;
  try {
    const r1 = await fetch('../data.json');
    if (r1.ok) data = await r1.json();
  } catch (e) { console.warn('data.json fetch failed:', e); }
  try {
    const r2 = await fetch('../tickers.json');
    if (r2.ok) tickers = await r2.json();
  } catch (e) { console.warn('tickers.json fetch failed:', e); }

  // Wire the brand bar regardless of which file loaded
  try {
    const bbClock = document.getElementById('bb-clock');
    function bbTick() {
      const d = new Date();
      bbClock.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()]
        .map(n => String(n).padStart(2,'0')).join(':') + ' ET';
    }
    if (bbClock) { bbTick(); setInterval(bbTick, 1000); }

    if (data?.regime) {
      const r = data.regime;
      const regEl = document.getElementById('bb-regime');
      if (regEl) regEl.textContent = (r.regime4 || r.regime || '—').toUpperCase().replace(/_/g, ' ');
    }
    if (data?.portfolio) {
      const eq = data.portfolio.equity;
      const start = 100000; // mock starting; real value would come from kelly_size config
      const pnl = eq != null ? eq - start : null;
      const pnlEl = document.getElementById('bb-pnl');
      if (pnlEl && pnl != null) {
        pnlEl.textContent = (pnl >= 0 ? '+$' : '-$') + Math.abs(pnl).toLocaleString('en-US', { maximumFractionDigits: 0 });
        pnlEl.style.color = pnl >= 0 ? 'var(--gn)' : 'var(--rd)';
      }
      // Drawdown — compute from equity_curve
      const curve = data.portfolio.equity_curve || [];
      if (curve.length && eq != null) {
        const peak = Math.max(...curve.map(c => c.equity || 0), eq);
        const dd = peak > 0 ? ((eq - peak) / peak) * 100 : 0;
        const ddEl = document.getElementById('bb-dd');
        if (ddEl) {
          ddEl.textContent = (dd >= 0 ? '+' : '') + dd.toFixed(1) + '%';
          ddEl.style.color = dd >= -3 ? 'var(--gn)' : dd >= -10 ? 'var(--amb)' : 'var(--rd)';
        }
      }
    }
  } catch (e) { console.warn('[kairos] brandbar wire failed:', e); }

  if (!data && !tickers) {
    console.warn('[kairos] no data available — keeping mock view');
    return;
  }

  // Helper: convert tickers object → sorted array
  const arr = tickers
    ? Object.entries(tickers).map(([sym, p]) => ({ ticker: p?.ticker || sym, ...p }))
        .sort((a, b) => (b.score || 0) - (a.score || 0))
    : [];

  // Each section in its own try/catch so a partial failure doesn't blank the page
  const safe = (label, fn) => { try { fn(); } catch (e) { console.warn(`[kairos] ${label} failed:`, e); } };

  // ─── HEADER — SPX / VIX / US10Y ────────────────────────────────
  safe('header', () => {
  if (data) {
    const reg = data.regime || {};
    const spy = reg.spy_price; const spyChg = reg.spy_daily_chg;
    const vix = (reg.vix || {}).vix_current; const vixPrev = (reg.vix || {}).vix_ma20;
    const head = document.querySelector('#pan-dash .head-r');
    if (head && spy != null) {
      head.innerHTML = `
        <span class="clock" id="clk">${document.getElementById('clk')?.textContent || '—'}</span>
        <span>SPX <b class="${spyChg >= 0 ? 'up' : 'down'} num">${spy.toFixed(2)} ${_pct(spyChg)}</b></span>
        <span>VIX <b class="${vix < 18 ? 'up' : vix < 25 ? 'amb' : 'down'} num">${vix?.toFixed(2) || '—'}${vixPrev ? ' (' + vix?.toFixed(2) + ')' : ''}</b></span>
        <span>BREADTH <b class="${reg.breadth_pct_50d >= 60 ? 'up' : 'amb'} num">${reg.breadth_pct_50d?.toFixed(1) || '—'}</b></span>
      `;
    }
  }
  });

  // ─── TAPE — top 7 tickers by score ─────────────────────────────
  safe('tape', () => {
  if (arr.length) {
    const tapeEl = document.querySelector('#pan-dash .tape .items');
    if (tapeEl) {
      const top = arr.slice(0, 7);
      tapeEl.innerHTML = top.map((t, i) => {
        const chg = t.perf_1d || t.pct_chg || 0;
        return `
          ${i > 0 ? '<span class="sep">·</span>' : ''}
          <span><b>${t.ticker}</b> ${t.price?.toFixed(2) || '—'} <span class="pct ${chg >= 0 ? 'up' : 'down'}">${_pct(chg)}%</span></span>
        `;
      }).join('');
    }
  }
  });

  // ─── WATCHLIST · BAP RANK — top 13 ─────────────────────────────
  safe('watchlist', () => {
  if (arr.length) {
    const wlBody = document.querySelector('#pan-dash .col:first-child table.tbl tbody');
    const wlHead = document.querySelector('#pan-dash .col:first-child .p-head .r');
    if (wlBody) {
      const top = arr.slice(0, 13);
      wlBody.innerHTML = top.map((t, i) => {
        const setup = (t.setup_family || t.setup || '—').slice(0, 12);
        const score = t.score || 0;
        const chg = t.perf_1d || t.pct_chg || 0;
        const rvol = t.rvol;
        const rr = t.rr_ratio || t.rr;
        const earn = t.earn_days != null ? `+${t.earn_days}d` : '—';
        const earnCls = (t.earn_days != null && t.earn_days <= 14) ? 'amb' : 'dim';
        return `
          <tr>
            <td class="idx">${String(i + 1).padStart(2, '0')}</td>
            <td class="sym" onclick="window.location.href='elite-detail.html?t=${t.ticker}&from=kairos'">${t.ticker}</td>
            <td class="setup">${setup}</td>
            <td class="bap ${_bapClass(score)}">${Math.round(score)}</td>
            <td class="r px num">${t.price?.toFixed(2) || '—'}</td>
            <td class="r ${chg >= 0 ? 'up' : 'down'} num">${_pct(chg)}</td>
            <td class="r dim num">${rvol ? rvol.toFixed(1) + '×' : '—'}</td>
            <td class="r dim num">${rr ? '1:' + rr.toFixed(1) : '—'}</td>
            <td class="r ${earnCls} num">${earn}</td>
          </tr>
        `;
      }).join('');
      if (wlHead) wlHead.innerHTML = `${arr.length} NAMES <b>·</b> ${arr.filter(t => (t.score || 0) >= 80).length} HOT`;
    }
  }
  });

  // ─── SECTORS · TODAY — from sector_etf ─────────────────────────
  safe('sectors', () => {
  if (data?.sector_etf) {
    const sectorAbbr = { 'Technology': 'TECH', 'Financials': 'FINX', 'Healthcare': 'HLTH', 'Energy': 'ENRG', 'Industrials': 'INDU', 'Materials': 'MATR', 'Real Estate': 'REIT', 'Utilities': 'UTIL', 'Communication Svcs': 'COMM', 'Consumer Staples': 'STPL', 'Consumer Discretionary': 'DISC' };
    const sects = Object.entries(data.sector_etf)
      .map(([etf, s]) => ({ etf, ...s }))
      .sort((a, b) => (b.perf_pct || 0) - (a.perf_pct || 0));
    const sectCol = document.querySelectorAll('#pan-dash .col')[1];
    if (sectCol) {
      const oldRows = sectCol.querySelectorAll('.sect-row');
      const newHtml = sects.map(s => {
        const pct = s.perf_pct || 0;
        const w = Math.min(80, Math.abs(pct) * 4); // map to bar width
        return `
          <div class="sect-row">
            <span class="lbl">${sectorAbbr[s.sector] || s.sector?.slice(0,4).toUpperCase()}</span>
            <span class="w">${s.rank ? '#' + s.rank : ''}</span>
            <span class="l">${s.outperforming ? '✓' : '—'}</span>
            <span class="bar"><span class="f ${pct >= 0 ? 'pos' : 'neg'}" style="width:${w}%"></span></span>
            <span class="pct ${pct >= 0 ? 'up' : 'down'} num">${_pct(pct)}</span>
          </div>
        `;
      }).join('');
      if (oldRows.length) {
        oldRows.forEach(r => r.remove());
        const sectHead = sectCol.querySelector('.p-head');
        if (sectHead) sectHead.insertAdjacentHTML('afterend', newHtml);
      }
    }
  }
  });

  // ─── ACCT · BLOTTER — from portfolio ───────────────────────────
  safe('blotter', () => {
  if (data?.portfolio) {
    const blot = document.querySelector('#pan-dash .blot');
    const blotHead = document.querySelector('#pan-dash .col:nth-child(2) .p-head:last-of-type .r');
    const positions = data.portfolio.positions || [];
    if (blot) {
      if (positions.length === 0) {
        blot.innerHTML = `<div class="blot-row" style="grid-template-columns:1fr;color:var(--ink-3);text-align:center;padding:20px"><span>no open positions · paper trading active</span></div>`;
        if (blotHead) blotHead.textContent = '0 OPEN';
      } else {
        blot.innerHTML = positions.map(p => `
          <div class="blot-row">
            <span class="sym">${p.ticker}</span>
            <span class="pos">${p.shares} @ <b>${p.entry_price?.toFixed(2) || '—'}</b></span>
            <span class="pct ${(p.unrealized_pnl_pct || 0) >= 0 ? 'up' : 'down'} num">${_pct(p.unrealized_pnl_pct || 0)}</span>
            <span class="pnl ${(p.unrealized_pnl_dollars || 0) >= 0 ? 'up' : 'down'} num">${(p.unrealized_pnl_dollars || 0) >= 0 ? '+' : ''}$${Math.abs(p.unrealized_pnl_dollars || 0).toFixed(0)}</span>
          </div>
        `).join('');
        if (blotHead) blotHead.textContent = `${positions.length} OPEN`;
      }
    }
  }
  });

  // ─── INTEL · WIRE — aggregate from all tickers' news ──────────
  safe('wire-and-news', () => {
  if (arr.length) {
    const allNews = [];
    arr.forEach(t => {
      (t.news_articles || []).forEach(a => {
        allNews.push({
          ticker: t.ticker,
          time: a.published_utc,
          title: a.title,
          source: (a.publisher && a.publisher.name) || a.source || 'WIRE',
          sentiment: a.insights?.[0]?.sentiment || null,
        });
      });
    });
    allNews.sort((a, b) => (b.time || '').localeCompare(a.time || ''));
    const wireCol = document.querySelectorAll('#pan-dash .col')[2];
    if (wireCol) {
      const wireBody = wireCol.querySelector(':scope > div:last-child');
      // Find the existing wire-row container
      const oldRows = wireCol.querySelectorAll('.wire-row');
      const newHtml = allNews.slice(0, 10).map(n => {
        const tsStr = n.time ? new Date(n.time).toTimeString().slice(0, 5) : '—';
        const sent = (n.sentiment || '').toLowerCase();
        const badge = sent === 'positive' ? 'bull' : sent === 'negative' ? 'bear' : 'neut';
        const badgeText = sent === 'positive' ? 'BULL' : sent === 'negative' ? 'BEAR' : 'NEUT';
        return `
          <div class="wire-row">
            <span class="ts num">${tsStr}</span>
            <span class="sym">${n.ticker}</span>
            <span class="txt">${(n.title || '').slice(0, 60)}${(n.title || '').length > 60 ? '…' : ''}</span>
            <span class="badge ${badge}">${badgeText}</span>
            <span class="src">${(n.source || '').toString().slice(0, 6).toUpperCase()}</span>
          </div>
        `;
      }).join('');
      if (oldRows.length && newHtml) {
        // Replace the container holding wire-rows
        const parent = oldRows[0].parentElement;
        if (parent) parent.innerHTML = newHtml;
      }
    }

    // ─── NEWS · LATEST (Yahoo-style featured + cards) ────────────
    if (allNews.length) {
      // Featured = first (most recent)
      const feat = allNews[0];
      const featEl = document.querySelector('.news-feat');
      if (featEl && feat) {
        const featTime = _ago(feat.time);
        featEl.querySelector('.news-tag').textContent = (feat.sentiment === 'positive' ? 'MARKETS' : 'BREAKING');
        featEl.querySelector('.meta-row').innerHTML = `
          <span class="news-tag ${feat.sentiment === 'positive' ? 'markets' : 'breaking'}">${feat.sentiment === 'positive' ? 'MARKETS' : 'BREAKING'}</span>
          <span><b>${featTime}</b></span>
          <span>${feat.ticker}</span>
        `;
        featEl.querySelector('.head').textContent = feat.title || '—';
        featEl.querySelector('.summ').innerHTML = `Tracked story for <b style="color:var(--cy)">${feat.ticker}</b>. Source: <b>${feat.source}</b>. Live feed updates throughout the session.`;
        featEl.querySelector('.src-row').innerHTML = `
          <span><b>${(feat.source || '').toUpperCase()}</b></span>
          <span>${feat.ticker} desk</span>
          <span>· ${featTime}</span>
        `;
      }

      // Top stories — next 5
      const topNewsCol = document.querySelectorAll('.news-col')[1];
      if (topNewsCol) {
        const cards = topNewsCol.querySelectorAll('.news-card');
        const head = topNewsCol.querySelector('.news-col-h .r');
        if (head) head.innerHTML = `<b>${allNews.length}</b> total`;
        allNews.slice(1, 6).forEach((n, i) => {
          if (!cards[i]) return;
          const tag = n.sentiment === 'positive' ? 'earnings' : n.sentiment === 'negative' ? 'breaking' : 'companies';
          const tagText = n.sentiment === 'positive' ? 'POSITIVE' : n.sentiment === 'negative' ? 'NEGATIVE' : 'COMPANIES';
          cards[i].querySelector('.row1').innerHTML = `
            <span class="news-tag ${tag}">${tagText}</span>
            <span><b>${_ago(n.time)}</b></span>
            <span>${n.ticker}</span>
          `;
          cards[i].querySelector('.h').textContent = n.title || '—';
          const summ = cards[i].querySelector('.s');
          if (summ) summ.innerHTML = `<b style="color:var(--cy)">${n.ticker}</b> · ${n.source}. Story tracked from the live wire.`;
          cards[i].querySelector('.src-line').innerHTML = `<b>${(n.source || '').toUpperCase()}</b> <span>· ${_ago(n.time)}</span>`;
        });
      }

      // Trending = top movers from arr
      const trendCol = document.querySelectorAll('.news-col')[2];
      if (trendCol) {
        const movers = arr.slice()
          .filter(t => t.perf_1d != null || t.pct_chg != null)
