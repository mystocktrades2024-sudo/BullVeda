<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Kairos · v12.04 · trader's dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/*
 * Kairos · pure terminal dashboard — matches the user's reference (Image 3 / 4).
 * No editorial register. Mono everywhere. Phosphor / amber / cyan / red on black.
 * Dense tables, 4-letter section codes, F-key strip, tab toggle.
 */

:root {
  --bg:        #000000;
  --bg-1:      #0a0d0c;
  --bg-2:      #0f1311;
  --bg-3:      #141816;
  --bg-hover:  #181f1c;
  --line:      #1d2520;
  --line-2:    #2a352e;

  --ink:       #d8d6cc;
  --ink-1:     #b0aea3;
  --ink-2:     #80847a;
  --ink-3:     #545851;
  --ink-4:     #2e312c;

  --gn:        #5be57c;
  --gn-dim:    #2f6b41;
  --gn-bg:     rgba(91,229,124,0.08);

  --amb:       #ffb95c;
  --amb-dim:   #8c5d20;
  --amb-bg:    rgba(255,185,92,0.06);

  --cy:        #5ec8d8;
  --cy-dim:    #2c6a74;
  --cy-bg:     rgba(94,200,216,0.07);

  --rd:        #ff6b5b;
  --rd-dim:    #7a2a22;
  --rd-bg:     rgba(255,107,91,0.06);

  --mono:      'JetBrains Mono', ui-monospace, monospace;
  --copper:    #d97757;
}

/* Big Kairos brand bar — top of page, always visible */
@import url('https://fonts.googleapis.com/css2?family=GT+Sectra:wght@500&display=swap');
.brandbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 28px 12px;
  background: linear-gradient(180deg, #0e1311 0%, #000 100%);
  border-bottom: 1px solid var(--line);
}
.brandbar-l { display: flex; align-items: baseline; gap: 16px; }
.brandbar-wm {
  font-family: 'GT Sectra', Georgia, serif;
  font-style: italic; font-weight: 500;
  font-size: 36px; line-height: 1; letter-spacing: -0.025em;
  color: var(--ink);
}
.brandbar-wm::first-letter { color: var(--copper); }
.brandbar-tag {
  font-family: var(--mono);
  font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase;
  color: var(--ink-3); padding-bottom: 4px;
}
.brandbar-r {
  display: flex; align-items: center; gap: 22px;
  font-family: var(--mono); font-size: 10.5px;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--ink-2);
}
.brandbar-r b { color: var(--ink); }
.brandbar-r .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--gn); box-shadow: 0 0 6px var(--gn); margin-right: 6px; vertical-align: 1px; }

/* ════════ LEFT SIDEBAR — workspaces + stats + quick tickers ═════════ */
.layout {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: calc(100vh - 64px);
}
.sidebar {
  background: var(--bg-1);
  border-right: 1px solid var(--line);
  overflow-y: auto;
  font-family: var(--mono);
  font-size: 11.5px;
  padding: 8px 0 20px;
}
.sb-section {
  border-bottom: 1px solid var(--line);
  padding: 10px 0 8px;
}
.sb-section:last-child { border-bottom: none; }
.sb-h {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 16px 4px;
  font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase;
  font-weight: 700;
  color: var(--ink-3);
  user-select: none;
}
.sb-link {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 16px;
  color: var(--ink-1);
  border-left: 2px solid transparent;
  cursor: pointer;
  transition: all 80ms;
  letter-spacing: 0.04em;
  font-size: 11.5px;
}
.sb-link:hover { background: var(--bg-2); color: var(--ink); }
.sb-link.on {
  background: var(--gn-bg); color: var(--gn);
  border-left-color: var(--gn);
  font-weight: 600;
}
.sb-link .ico { color: var(--amb); font-size: 12px; min-width: 16px; display: inline-block; }
.sb-link .ct {
  margin-left: auto;
  font-size: 9.5px; letter-spacing: 0;
  padding: 1px 6px;
  background: var(--bg-3);
  color: var(--ink-3);
  border-radius: 2px;
  font-variant-numeric: tabular-nums;
}
.sb-link.on .ct { background: var(--gn-dim); color: #061008; }
.sb-link.warn .ct { background: var(--rd-bg); color: var(--rd); }
.sb-link .kbd {
  margin-left: auto;
  font-size: 9.5px; color: var(--ink-3);
  border: 1px solid var(--ink-4);
  padding: 0 5px; border-radius: 2px;
}
.sb-link a, .sb-link a:visited { color: inherit; text-decoration: none; }

.sb-stats {
  padding: 10px 16px 4px;
  border-bottom: 1px solid var(--line);
}
.sb-stat-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 4px 0;
  font-size: 11px;
}
.sb-stat-row .l { color: var(--ink-2); letter-spacing: 0.04em; }
.sb-stat-row .v { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
.sb-stat-row .v.up { color: var(--gn); }
.sb-stat-row .v.down { color: var(--rd); }
.sb-stat-row .v.amb { color: var(--amb); }

.sb-quick {
  padding: 8px 14px;
}
.sb-quick-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 4px;
  margin-top: 4px;
}
.sb-quick-chip {
  padding: 5px 8px;
  background: var(--bg-2);
  border: 1px solid var(--line);
  font-size: 10.5px;
  display: flex; justify-content: space-between; align-items: center; gap: 4px;
  cursor: pointer;
  transition: all 60ms;
}
.sb-quick-chip:hover { border-color: var(--cy); }
.sb-quick-chip b { color: var(--cy); font-weight: 700; font-size: 11px; }
.sb-quick-chip .pct { color: var(--ink-3); font-size: 10px; font-variant-numeric: tabular-nums; }
.sb-quick-chip .pct.up { color: var(--gn); }
.sb-quick-chip .pct.down { color: var(--rd); }

.main { overflow-y: auto; }

@media (max-width: 1100px) {
  .layout { grid-template-columns: 200px 1fr; }
}

* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--mono);
  font-size: 12.5px; line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font: inherit; border: none; background: none; color: inherit; cursor: pointer; }

.num { font-variant-numeric: tabular-nums; }
.up   { color: var(--gn); }
.down { color: var(--rd); }
.amb  { color: var(--amb); }
.cy   { color: var(--cy); }
.dim  { color: var(--ink-2); }
.dim2 { color: var(--ink-3); }

/* ════════ Top tab bar (DASHBOARD / DETAIL) ═══════════════════════ */
.tabs {
  display: flex; align-items: center; gap: 28px;
  padding: 14px 24px 0 24px;
  border-bottom: 1px solid var(--line);
}
.tab {
  font-family: var(--mono);
  font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase;
  font-weight: 600;
  color: var(--ink-3); padding: 6px 4px 14px; cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: color 100ms, border-color 100ms;
}
.tab:hover { color: var(--ink-1); }
.tab.on { color: var(--ink); border-bottom-color: var(--amb); }

.page { padding: 14px 16px 0; }
.panel { display: none; }
.panel.on { display: block; }

/* ════════ Header strip ═══════════════════════════════════════════ */
.head {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center; gap: 24px;
  padding: 10px 14px;
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-bottom: none;
  font-size: 11.5px; letter-spacing: 0.02em;
}
.head-l { display: flex; align-items: center; gap: 16px; }
.head-l .brand {
  color: var(--amb); font-weight: 700; letter-spacing: 0.12em;
}
.head-l .brand b { color: var(--ink); }
.head-l .nav { color: var(--ink-1); letter-spacing: 0.08em; }
.head-l .feeds { display: flex; gap: 12px; color: var(--ink-2); }
.head-l .feeds span { display: inline-flex; align-items: center; gap: 5px; }
.head-l .feeds .d {
  width: 6px; height: 6px; border-radius: 50%; background: var(--gn);
  box-shadow: 0 0 6px var(--gn);
}
.head-r {
  display: flex; align-items: center; gap: 22px;
  color: var(--ink-2);
}
.head-r b { color: var(--ink); margin-left: 6px; }
.head-r .clock { color: var(--ink); font-weight: 600; letter-spacing: 0.04em; }

/* TAPE row */
.tape {
  display: grid; grid-template-columns: 60px 1fr;
  align-items: center;
  padding: 9px 14px;
  background: var(--bg-1);
  border: 1px solid var(--line); border-top: 1px solid var(--line);
  font-size: 11.5px;
}
.tape .lbl {
  color: var(--ink-3); font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase;
  font-weight: 700;
}
.tape .items { display: flex; gap: 22px; flex-wrap: wrap; }
.tape .items span { color: var(--ink-2); }
.tape .items b { color: var(--ink); font-weight: 600; }
.tape .items .pct.up { color: var(--gn); }
.tape .items .pct.down { color: var(--rd); }
.tape .items .sep { color: var(--ink-4); margin-right: -10px; }

/* ════════ Dashboard grid ═════════════════════════════════════════ */
.grid {
  display: grid;
  grid-template-columns: 1.45fr 1fr 1.05fr;
  gap: 0;
  border: 1px solid var(--line); border-top: none;
}
.col { border-right: 1px solid var(--line); }
.col:last-child { border-right: none; }

/* Panel head — 4-letter code + title + right meta */
.p-head {
  display: grid; grid-template-columns: 1fr auto;
  align-items: center; gap: 14px;
  padding: 10px 14px 10px 14px;
  background: var(--bg-2);
  border-bottom: 1px solid var(--line);
  font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase;
}
.p-head .l { color: var(--ink-1); font-weight: 600; }
.p-head .l b { color: var(--ink); }
.p-head .r { color: var(--ink-3); letter-spacing: 0.14em; font-weight: 500; }
.p-head .r b.gn { color: var(--gn); }

/* Tables */
table.tbl {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--mono);
  font-size: 11.5px;
}
table.tbl th {
  text-align: left;
  padding: 8px 10px;
  font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3); font-weight: 600;
  border-bottom: 1px solid var(--line);
  background: var(--bg-1);
}
table.tbl th.r { text-align: right; }
table.tbl td {
  padding: 7px 10px;
  border-bottom: 1px solid var(--ink-4);
  font-variant-numeric: tabular-nums;
}
table.tbl td.r { text-align: right; }
table.tbl tr:hover td { background: var(--bg-hover); }
table.tbl td.idx { color: var(--ink-3); font-size: 10.5px; }
table.tbl td.sym { color: var(--cy); font-weight: 700; cursor: pointer; }
table.tbl td.sym:hover { color: var(--ink); text-shadow: 0 0 8px var(--cy-dim); }
table.tbl td.setup { color: var(--ink-1); font-size: 11px; letter-spacing: 0.04em; }
table.tbl td.bap {
  font-weight: 700;
  position: relative;
  text-align: center;
  background: rgba(91,229,124,0.06);
  color: var(--gn);
}
table.tbl td.bap.lo { color: var(--amb); background: rgba(255,185,92,0.05); }
table.tbl td.bap.bad { color: var(--rd); background: rgba(255,107,91,0.05); }
table.tbl td.px { color: var(--ink); font-weight: 600; }

/* Bottom row: PROS / CONS / BEST IF — removed in production */

/* SECT rows (compact) */
.sect-row {
  display: grid; grid-template-columns: 56px 60px 60px 1fr auto;
  align-items: center; gap: 8px;
  padding: 7px 14px;
  border-bottom: 1px solid var(--ink-4);
  font-size: 11.5px;
}
.sect-row .lbl { color: var(--ink); font-weight: 700; letter-spacing: 0.04em; }
.sect-row .w { color: var(--gn); font-size: 10.5px; }
.sect-row .l { color: var(--rd); font-size: 10.5px; }
.sect-row .bar {
  height: 4px; background: var(--ink-4);
  position: relative; overflow: hidden;
}
.sect-row .bar .f { position: absolute; left: 50%; top: 0; bottom: 0; }
.sect-row .bar .f.pos { background: var(--gn); transform: translateX(0); }
.sect-row .bar .f.neg { background: var(--rd); transform: translateX(-100%); }
.sect-row .pct { font-weight: 700; min-width: 50px; text-align: right; }

/* ACCT · BLOTTER */
.blot {
  background: var(--bg-1);
}
.blot-row {
  display: grid; grid-template-columns: 60px 1fr auto auto;
  align-items: center; gap: 14px;
  padding: 8px 14px;
  border-bottom: 1px solid var(--ink-4);
  font-size: 11.5px;
}
.blot-row .sym { color: var(--cy); font-weight: 700; }
.blot-row .pos { color: var(--ink-2); font-size: 11px; }
.blot-row .pos b { color: var(--ink-1); font-weight: 500; }
.blot-row .pct { font-weight: 600; min-width: 50px; text-align: right; }
.blot-row .pnl { font-weight: 700; min-width: 60px; text-align: right; }

/* INTEL · WIRE */
.wire-row {
  display: grid; grid-template-columns: 56px 56px 1fr auto auto;
  align-items: center; gap: 10px;
  padding: 9px 14px;
  border-bottom: 1px solid var(--ink-4);
  font-size: 11.5px;
}
.wire-row .ts { color: var(--ink-2); font-size: 11px; letter-spacing: 0.02em; }
.wire-row .sym { color: var(--cy); font-weight: 700; }
.wire-row .txt { color: var(--ink-1); line-height: 1.4; font-size: 11.5px; }
.wire-row .badge {
  padding: 2px 7px; font-size: 9.5px; letter-spacing: 0.14em; font-weight: 700;
  text-align: center; min-width: 38px;
}
.wire-row .badge.bull { background: var(--gn-bg); color: var(--gn); border: 1px solid var(--gn-dim); }
.wire-row .badge.bear { background: var(--rd-bg); color: var(--rd); border: 1px solid var(--rd-dim); }
.wire-row .badge.mac  { background: var(--cy-bg); color: var(--cy); border: 1px solid var(--cy-dim); }
.wire-row .badge.neut { background: var(--amb-bg); color: var(--amb); border: 1px solid var(--amb-dim); }
.wire-row .src { color: var(--ink-3); font-size: 10px; letter-spacing: 0.12em; min-width: 38px; text-align: right; }

/* F-keys */
.fkeys {
  display: grid; grid-template-columns: repeat(8, 1fr);
  background: var(--bg-2);
  border: 1px solid var(--line); border-bottom: none;
}
.fk {
  display: flex; align-items: baseline; gap: 8px;
  padding: 7px 12px;
  border-right: 1px solid var(--line);
  font-size: 10.5px; letter-spacing: 0.06em;
  color: var(--ink-2);
  cursor: pointer;
  transition: color 80ms, background 80ms;
}
.fk:last-child { border-right: none; }
.fk b { color: var(--amb); font-weight: 700; letter-spacing: 0.06em; }
.fk:hover { color: var(--ink); background: var(--bg-3); }
.fk.on { background: var(--gn-bg); color: var(--gn); }
.fk.on b { color: var(--gn); }

/* ════════ NEWS · LATEST (Yahoo-style cards) ═══════════════════════ */
.news {
  margin-top: 0;
  border: 1px solid var(--line);
  border-top: none;
  background: var(--bg-1);
}
.news-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr;
  gap: 0;
}
.news-col { border-right: 1px solid var(--line); padding: 14px 16px; min-height: 300px; }
.news-col:last-child { border-right: none; }

/* Featured story (left big) */
.news-feat {
  display: flex; flex-direction: column;
  gap: 12px;
}
.news-feat-img {
  width: 100%; aspect-ratio: 16/9;
  background: linear-gradient(135deg, var(--cy-bg) 0%, var(--gn-bg) 40%, #14181a 100%);
  border: 1px solid var(--line-2);
  position: relative;
  overflow: hidden;
}
.news-feat-img::after {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 30% 40%, rgba(94,200,216,0.12), transparent 50%),
    radial-gradient(ellipse at 70% 70%, rgba(91,229,124,0.10), transparent 60%);
}
.news-feat-img .ph {
  position: absolute; left: 16px; bottom: 14px; right: 16px;
  display: flex; gap: 8px; align-items: center;
  font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--ink-1);
}
.news-feat-img .ph .live {
  width: 6px; height: 6px; border-radius: 50%; background: var(--rd);
  box-shadow: 0 0 6px var(--rd);
}

.news-tag {
  display: inline-block;
  font-family: var(--mono);
  font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase;
  font-weight: 700;
  padding: 3px 8px;
  border: 1px solid;
  color: var(--cy); border-color: var(--cy-dim); background: var(--cy-bg);
}
.news-tag.markets   { color: var(--cy); border-color: var(--cy-dim); background: var(--cy-bg); }
.news-tag.earnings  { color: var(--gn); border-color: var(--gn-dim); background: var(--gn-bg); }
.news-tag.macro     { color: var(--amb); border-color: var(--amb-dim); background: var(--amb-bg); }
.news-tag.crypto    { color: #c084fc; border-color: #6b1f9a; background: rgba(192,132,252,0.06); }
.news-tag.companies { color: var(--ink-1); border-color: var(--line-2); background: var(--bg-3); }
.news-tag.breaking  { color: var(--rd); border-color: var(--rd-dim); background: var(--rd-bg); }

.news-feat .meta-row {
  display: flex; align-items: center; gap: 12px;
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;
  color: var(--ink-3); text-transform: uppercase;
}
.news-feat .meta-row b { color: var(--ink-1); }
.news-feat .head {
  font-family: var(--mono); font-weight: 600;
  font-size: 19px; line-height: 1.3;
  color: var(--ink); letter-spacing: -0.005em;
  margin-top: 2px; cursor: pointer;
  background: none; border: none; padding: 0;
}
.news-feat .head:hover { color: var(--cy); }
.news-feat .summ {
  font-family: var(--mono); font-weight: 400;
  font-size: 12px; line-height: 1.55;
  color: var(--ink-1);
  margin-top: 0;
}
.news-feat .src-row {
  display: flex; gap: 12px;
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
  color: var(--ink-3); text-transform: uppercase;
  margin-top: 6px;
  padding-top: 10px; border-top: 1px dashed var(--ink-4);
}
.news-feat .src-row b { color: var(--cy); }

/* Sub-cards in right columns */
.news-card {
  padding: 12px 0;
  border-bottom: 1px solid var(--ink-4);
  cursor: pointer;
  transition: background 80ms;
}
.news-card:first-child { padding-top: 0; }
.news-card:last-child { border-bottom: none; }
.news-card .row1 {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 6px;
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;
  color: var(--ink-3); text-transform: uppercase;
}
.news-card .row1 b { color: var(--ink-1); font-weight: 500; }
.news-card .h {
  font-family: var(--mono); font-weight: 500;
  font-size: 13.5px; line-height: 1.35;
  color: var(--ink); letter-spacing: -0.002em;
}
.news-card:hover .h { color: var(--cy); }
.news-card .s {
  font-family: var(--mono); font-weight: 400;
  font-size: 11px; line-height: 1.5;
  color: var(--ink-2);
  margin-top: 5px;
}
.news-card .src-line {
  display: flex; gap: 10px;
  font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.1em;
  color: var(--ink-3); text-transform: uppercase;
  margin-top: 8px;
}
.news-card .src-line b { color: var(--ink-2); }

/* News column head */
.news-col-h {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}
.news-col-h .t {
  font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em;
  text-transform: uppercase; font-weight: 700;
  color: var(--amb);
}
.news-col-h .r {
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--ink-3);
}
.news-col-h .r b { color: var(--ink-1); }

/* Trending tickers (rightmost column variation) */
.trend-row {
  display: grid; grid-template-columns: 30px 1fr auto auto;
  gap: 10px; align-items: center;
  padding: 7px 0;
  border-bottom: 1px solid var(--ink-4);
  font-size: 11.5px; cursor: pointer;
}
.trend-row:hover { background: var(--bg-3); }
.trend-row .idx { color: var(--ink-3); font-size: 10.5px; }
.trend-row .sym { color: var(--cy); font-weight: 700; }
.trend-row .mini-bar {
  width: 50px; height: 14px;
  background: var(--ink-4);
  position: relative; overflow: hidden;
}
.trend-row .mini-bar .b {
  position: absolute; bottom: 0; width: 4px;
  background: var(--gn);
}
.trend-row .pct { font-variant-numeric: tabular-nums; font-weight: 600; min-width: 50px; text-align: right; }
.trend-row .pct.up { color: var(--gn); }
.trend-row .pct.down { color: var(--rd); }

/* News footer */
.news-foot {
  padding: 12px 16px;
  border-top: 1px solid var(--line);
  background: var(--bg-2);
  display: flex; justify-content: space-between; align-items: center;
  font-family: var(--mono);
  font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
}
.news-foot a { color: var(--cy); cursor: pointer; }
.news-foot a:hover { color: var(--ink); }

/* ════════ DETAIL panel (Image 4) ════════════════════════════════ */
.det-head {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center; gap: 24px;
  padding: 18px 22px;
  background: var(--bg-2);
  border: 1px solid var(--line);
}
.det-head .tk-big {
  font-size: 40px; font-weight: 700; letter-spacing: -0.025em;
  color: var(--amb); line-height: 1;
}
.det-head .name {
  color: var(--ink-2); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  margin-left: 14px;
  align-self: center;
}
.det-head .px {
  font-size: 38px; font-weight: 700;
  color: var(--gn);
  letter-spacing: -0.02em;
  margin-left: auto; align-self: center;
}
.det-head .pct {
  color: var(--gn); font-size: 14px; letter-spacing: 0.04em;
  align-self: center;
}
.det-head .right { text-align: right; display: flex; flex-direction: column; gap: 6px; }
.det-head .verdict {
  display: inline-block;
  padding: 8px 18px;
  border: 1.5px solid var(--gn);
  color: var(--gn);
  font-size: 12px; letter-spacing: 0.14em; font-weight: 700;
  cursor: pointer;
}
.det-head .verdict:hover { background: var(--gn-bg); }
.det-head .meta { font-size: 10.5px; letter-spacing: 0.14em; color: var(--ink-2); text-transform: uppercase; }
.det-head .meta b { color: var(--ink); }

.det-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr 1.1fr 0.9fr;
  border: 1px solid var(--line); border-top: none;
}

/* Mock chart panel */
.chart-mock {
  padding: 18px;
  border-right: 1px solid var(--line);
  display: flex; flex-direction: column;
  gap: 12px;
  background: var(--bg-1);
  min-height: 360px;
}
.chart-svg { width: 100%; height: 220px; }
.chart-foot {
  display: flex; gap: 16px;
  font-size: 11px; color: var(--ink-2);
  letter-spacing: 0.08em;
  padding-top: 8px;
  border-top: 1px solid var(--line);
}

/* PILLARS sub-table inside chart column */
.pillars { margin-top: auto; }
.pillar-row {
  display: grid; grid-template-columns: 40px 1fr auto;
  gap: 12px; padding: 6px 0;
  border-bottom: 1px solid var(--ink-4);
  font-size: 11px;
}
.pillar-row .l { color: var(--ink-2); font-size: 10px; letter-spacing: 0.14em; }
.pillar-row .d { color: var(--ink-1); font-size: 10.5px; }
.pillar-row .v { color: var(--ink); font-weight: 700; font-size: 13px; text-align: right; }
.pillar-row .v.amb { color: var(--amb); }
.pillar-row .v.cy { color: var(--cy); }

/* MTF table */
.mtf-tbl, .ev-tbl {
  width: 100%; border-collapse: collapse; font-size: 11.5px;
}
.mtf-tbl th, .ev-tbl th {
  text-align: left; padding: 7px 10px;
  font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--ink-3); font-weight: 600;
  border-bottom: 1px solid var(--line);
  background: var(--bg-2);
}
.mtf-tbl td, .ev-tbl td {
  padding: 7px 10px;
  border-bottom: 1px solid var(--ink-4);
}
.mtf-tbl td.tf { color: var(--ink); font-weight: 700; }
.mtf-tbl td.stg { color: var(--gn); }
.mtf-tbl td.ok { color: var(--gn); text-align: right; }
.mtf-tbl td.ok.warn { color: var(--amb); }

/* PLAN · LADDER */
.ladd {
  display: grid; grid-template-columns: 70px 1fr auto auto;
  gap: 14px; align-items: center;
  padding: 7px 12px;
  border-bottom: 1px solid var(--ink-4);
  font-size: 11.5px;
}
.ladd .lbl { color: var(--ink-2); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; }
.ladd .px { color: var(--ink); font-weight: 700; }
.ladd .note { color: var(--ink-2); text-align: right; font-size: 10.5px; letter-spacing: 0.06em; }
.ladd .delta { color: var(--gn); font-weight: 600; text-align: right; min-width: 50px; }
