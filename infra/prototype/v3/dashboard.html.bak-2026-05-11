// ─── workspace renderer helpers ────────────────────────────────────────
function v3RenderTickerList(arr, n = 8) {
  if (!arr || !arr.length) return '<div class="v3-empty">— no candidates —</div>';
  return arr.slice(0, n).map(t => {
    const chg = t.perf_1d ?? t.pct_chg ?? 0;
    return `<div class="v3-row clickable" onclick="window.location.href='../elite-detail.html?t=${t.ticker}'">
      <span class="v3-sy">${t.ticker}</span>
      <span class="v3-set">${(t.setup_family || t.setup || '—').replace(/_/g,' ')}</span>
      <span class="v3-bap">${Math.round(t.score || 0)}</span>
      <span class="v3-px ${chg >= 0 ? 'up' : 'down'}">${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%</span>
    </div>`;
  }).join('');
}
function v3GenericList(items) {
  if (!items || !items.length) return '<div class="v3-empty">— no items —</div>';
  return items.map(it => `<div class="v3-row v3-row-1col">${it}</div>`).join('');
}
function v3FactorBars() {
  const factors = [['Trend',82],['Momentum',74],['Structure',68],['Quality',91],['Sentiment',71]];
  return factors.map(([n,v]) => `
    <div class="v3-bar-row">
      <span class="v3-bar-l">${n}</span>
      <span class="v3-bar-track"><span class="v3-bar-fill" style="width:${v}%"></span></span>
      <span class="v3-bar-v">${v}</span>
    </div>
  `).join('');
}
function v3ThesisCards(arr) {
  return arr.filter(t => t.thesis_card).slice(0,4).map(t => `
    <div class="v3-thesis-card">
      <div class="v3-thesis-h"><b>${t.ticker}</b> · <span class="amb">${(t.setup_family||'—').replace(/_/g,' ')}</span></div>
      <div class="v3-thesis-b">${(t.thesis_card || '').slice(0,140)}…</div>
    </div>
  `).join('') || '<div class="v3-empty">No theses in this scan</div>';
}
function v3OptionsTape(d) {
  const flow = (d?.options_flow_top30 || []).slice(0,8);
  if (!flow.length) return '<div class="v3-empty">No UOA today</div>';
  return flow.map(f => `<div class="v3-row">
    <span class="v3-sy">${f.ticker}</span>
    <span class="v3-set">${f.strike || ''}${f.right || ''}</span>
    <span class="v3-px">${(f.notional/1000).toFixed(0)}k</span>
    <span class="v3-px ${(f.bias || '').toLowerCase() === 'bull' ? 'up' : 'down'}">${f.bias || '—'}</span>
  </div>`).join('');
}
function v3EarningsTable(d) {
  const items = (d?.earnings_watchlist || []).slice(0,8);
  if (!items.length) return '<div class="v3-empty">No earnings in scan</div>';
  return items.map(e => `<div class="v3-row">
    <span class="v3-sy">${e.ticker}</span>
    <span class="v3-set">${e.date || '—'}</span>
    <span class="v3-px">${e.report_time || '—'}</span>
    <span class="v3-px ${e.beat_score >= 0.65 ? 'up' : ''}">${e.beat_score ? (e.beat_score * 100).toFixed(0) + '%' : '—'}</span>
  </div>`).join('');
}
function v3CalendarList(d) {
  const items = (d?.economic_events || []).slice(0,6);
  if (!items.length) return v3GenericList(['No macro events queued']);
  return items.map(e => `<div class="v3-row">
    <span class="v3-sy">+${e.days_ahead || 0}d</span>
    <span class="v3-set">${e.title || e.name || '—'}</span>
    <span class="v3-px">${e.impact || '—'}</span>
  </div>`).join('');
}
function v3WatchTable(arr) {
  return v3RenderTickerList(arr.filter(t => (t.score||0) >= 60), 12);
}
function v3SetupBreakdown(arr) {
  const counts = {};
  arr.forEach(t => { const s = t.setup_family || 'unknown'; counts[s] = (counts[s] || 0) + 1; });
  const rows = Object.entries(counts).sort((a,b) => b[1] - a[1]).slice(0,6);
  return rows.map(([s,c]) => `<div class="v3-row"><span class="v3-set">${s.replace(/_/g,' ')}</span><span class="v3-px">${c}</span></div>`).join('') || '<div class="v3-empty">—</div>';
}
function v3PortfolioOpen(d) {
  const pos = d?.portfolio?.positions || [];
  if (!pos.length) return '<div class="v3-empty">no open positions</div>';
  return pos.map(p => `<div class="v3-row">
    <span class="v3-sy">${p.ticker}</span>
    <span class="v3-set">${p.shares} @ ${p.entry_price?.toFixed(2)}</span>
    <span class="v3-px ${(p.unrealized_pnl_dollars||0) >= 0 ? 'up' : 'down'}">${(p.unrealized_pnl_dollars||0) >= 0 ? '+' : '-'}$${Math.abs(p.unrealized_pnl_dollars||0).toFixed(0)}</span>
    <span class="v3-px">${(p.unrealized_pnl_pct || 0).toFixed(1)}%</span>
  </div>`).join('');
}
function v3PortfolioRisk(d) {
  const pos = d?.portfolio?.positions || [];
  const eq = d?.portfolio?.equity || 0;
  const totalRisk = pos.reduce((s,p) => s + Math.max(0, (p.entry_price - (p.stop || 0)) * (p.shares || 0)), 0);
  const riskPct = eq > 0 ? (totalRisk / eq) * 100 : 0;
  return v3GenericList([
    `Open positions · <b>${pos.length}</b>`,
    `Risk at stop · <b>$${totalRisk.toFixed(0)}</b>`,
    `Risk % equity · <b>${riskPct.toFixed(1)}%</b> of 3% cap`,
    `Equity · <b>$${eq.toFixed(0)}</b>`,
  ]);
}
function v3KilledList(d) {
  const k = d?.killed_list || d?.suppressed || [];
  if (!k.length) return v3GenericList(['No active kills (' + (d?.killed_count || 0) + ' on record)']);
  return k.slice(0,10).map(t => `<div class="v3-row">
    <span class="v3-sy">${t.ticker || t}</span>
    <span class="v3-set">${t.reason || 'suppressed'}</span>
  </div>`).join('');
}
function v3PerfTiles(d) {
  const p = d?.performance || {};
  const wr = p.win_rate_30d || p.win_rate;
  const pct = wr ? Math.round(wr * (wr <= 1 ? 100 : 1)) : null;
  return v3GenericList([
    `Win rate · <b>${pct != null ? pct + '%' : '—'}</b>`,
    `Wins · <b>${p.wins_30d || p.wins || '—'}</b> · Losses · <b>${p.losses_30d || p.losses || '—'}</b>`,
    `Profit factor · <b>${p.profit_factor || '—'}</b>`,
    `Avg R · <b>${p.avg_r || '—'}</b>`,
  ]);
}
function v3SectorList(d) {
  const sects = Object.entries(d?.sector_etf || {}).map(([etf,s]) => ({etf, ...s})).sort((a,b) => (b.perf_pct||0) - (a.perf_pct||0)).slice(0,9);
  if (!sects.length) return '<div class="v3-empty">—</div>';
  return sects.map(s => {
    const p = s.perf_pct || 0;
    return `<div class="v3-row">
      <span class="v3-set">${s.sector || s.etf}</span>
      <span class="v3-px ${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '+' : ''}${p.toFixed(2)}%</span>
    </div>`;
  }).join('');
}
function v3RegimeStrip(d) {
  const r = d?.regime || {};
  return v3GenericList([
    `Regime · <b>${(r.regime4 || '—').replace(/_/g,' ').toUpperCase()}</b>`,
    `SPY · <b>${r.spy_price?.toFixed(2) || '—'}</b>`,
    `VIX · <b>${(r.vix||{}).vix_current?.toFixed(2) || '—'}</b>`,
    `Breadth >50d · <b>${r.breadth_pct_50d?.toFixed(0) || '—'}%</b>`,
  ]);
}
function v3IntelList(arr) {
  const news = [];
  arr.forEach(t => (t.news_articles || []).forEach(n => news.push({ ticker: t.ticker, title: n.title, sent: n.insights?.[0]?.sentiment })));
  if (!news.length) return v3GenericList(['Wire quiet']);
  return news.slice(0,6).map(n => `<div class="v3-row">
    <span class="v3-sy">${n.ticker}</span>
    <span class="v3-set">${(n.title || '').slice(0,40)}…</span>
    <span class="v3-px ${n.sent === 'positive' ? 'up' : n.sent === 'negative' ? 'down' : ''}">${(n.sent || 'neut').slice(0,4)}</span>
  </div>`).join('');
}

function setupV3Workspaces(arr, data) {
  // Ensure the generic workspace panel exists in DOM (create lazily)
  let wsPanel = document.getElementById('pan-workspace');
  if (!wsPanel) {
    wsPanel = document.createElement('div');
    wsPanel.id = 'pan-workspace';
    wsPanel.className = 'panel';
    document.querySelector('.page').appendChild(wsPanel);
  }
  const render = (key) => {
    const ws = V3_WORKSPACES[key];
    if (!ws) {
      wsPanel.innerHTML = `<div class="head"><div class="head-l"><span class="brand">KAIROS · ${key.toUpperCase()}</span></div></div>
        <div class="det-head"><div><span class="tk-big">${key.toUpperCase()}</span><span class="name">workspace · in build</span></div></div>
        <div class="v3-empty" style="padding:60px;text-align:center;font-family:var(--mono);color:var(--ink-2)">This workspace renders into the same 4-column detail-pattern blueprint.</div>`;
      return;
    }
    const cols = ['col1','col2','col3','col4'].map(c => {
      const col = ws[c];
      let bodyHTML = '';
      try { bodyHTML = col.body(data, arr); } catch (e) { bodyHTML = '<div class="v3-empty">— error rendering —</div>'; }
      return `<div>
        <div class="p-head"><div class="l"><span class="amb">${col.h}</span></div><div class="r">${col.meta}</div></div>
        ${bodyHTML}
      </div>`;
    }).join('');
    wsPanel.innerHTML = `
      <div class="head">
        <div class="head-l"><span class="brand">KAIROS · ${ws.title.toUpperCase()}</span><span class="nav dim">${ws.sub}</span></div>
        <div class="head-l"></div>
        <div class="head-r"><span class="clock" id="clkws">—</span></div>
      </div>
      <div class="det-head">
        <div><span class="tk-big">${ws.title}</span><span class="name">${ws.sub.toUpperCase()}</span></div>
        <div class="right"><span class="meta">FOLLOWS · DETAIL · BLUEPRINT</span></div>
      </div>
      <div class="det-grid">${cols}</div>
    `;
  };
  const switchTo = (panKey) => {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('on'));
    if (panKey === 'dash' || panKey === 'detail') {
      document.getElementById('pan-' + panKey)?.classList.add('on');
    } else {
      render(panKey);
      wsPanel.classList.add('on');
    }
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.toggle('on', t.dataset.pan === panKey || (panKey !== 'dash' && panKey !== 'detail' && t.dataset.pan === 'workspace'));
    });
    document.querySelectorAll('.sb-link').forEach(l => l.classList.toggle('on', l.dataset.tab === panKey));
    window.scrollTo({top:0, behavior:'instant'});
  };
  document.querySelectorAll('.sb-link[data-tab]').forEach(el => {
    el.style.cursor = 'pointer';
    el.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;
      const tab = el.dataset.tab;
      if (!tab) return;
      switchTo(tab);
    });
  });
  // Top tabs Dashboard / Detail handled by existing handler above
  window._v3SwitchTo = switchTo;
}
