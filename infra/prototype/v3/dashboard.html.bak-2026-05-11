.ladd.now .lbl, .ladd.now .px { color: var(--gn); }
.ladd.stop .px, .ladd.stop .delta { color: var(--rd); }
.ladd.stop .lbl { color: var(--rd); }

/* INTEL panel (right) */
.det-intel { font-size: 11.5px; }

/* HIST trades */
.hist-row {
  display: grid; grid-template-columns: 36px 60px 1fr auto auto;
  gap: 10px; align-items: center;
  padding: 7px 12px;
  border-bottom: 1px solid var(--ink-4);
