.hist-row .badge.w { color: var(--gn); border: 1px solid var(--gn-dim); background: var(--gn-bg); }
.hist-row .badge.l { color: var(--rd); border: 1px solid var(--rd-dim); background: var(--rd-bg); }
.hist-row .pnl { color: var(--gn); font-weight: 600; text-align: right; min-width: 60px; }
