# SwingTrade — example environment file
# Copy to .env and fill in real values. Never commit .env.

# Alpaca (paper trading)
ALPACA_API_KEY=PK_YOUR_ALPACA_PAPER_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_PAPER_SECRET_HERE

# Data vendors — get keys from each provider.
# FMP + Finnhub dropped 2026-04-24 — Schwab /instruments?projection=fundamental
# now supplies all fundamentals with no rate limit. SCHWAB_APP_KEY/SECRET below
# are required for fundamentals (in addition to options chains/quotes).
POLYGON_API_KEY=YOUR_POLYGON_KEY_HERE
FINVIZ_TOKEN=YOUR_FINVIZ_TOKEN_HERE
MASSIVE_ACCESS_KEY_ID=YOUR_MASSIVE_ACCESS_KEY_HERE
MASSIVE_SECRET_KEY=YOUR_MASSIVE_SECRET_HERE

# Schwab OAuth (run: python3 schwab_auth.py oauth once, then tokens auto-refresh)
SCHWAB_APP_KEY=YOUR_SCHWAB_APP_KEY_HERE
SCHWAB_APP_SECRET=YOUR_SCHWAB_APP_SECRET_HERE
SCHWAB_CALLBACK_URL=https://127.0.0.1
# These three are written automatically by schwab_auth.py — do not hand-edit
# SCHWAB_ACCESS_TOKEN=...
# SCHWAB_REFRESH_TOKEN=...
# SCHWAB_TOKEN_EXPIRES_AT=...

# Email + Slack
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Webull OpenAPI — official options data (added 2026-04-29)
# Used to fill the options gap (IV rank, P/C ratio, UOA) since Unicornbay
# is not subscribed. Apply for credentials at developer.webull.com.
WEBULL_APP_KEY=YOUR_WEBULL_APP_KEY_HERE
WEBULL_APP_SECRET=YOUR_WEBULL_APP_SECRET_HERE
